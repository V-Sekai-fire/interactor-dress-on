+# interactor-dress-on (tools/services/pixal3d/patches/naf-na2d-block.patch):
+# no NATTEN build exists for win-64, so the cross-scale attention runs as
+# na2d_block, the exact pure-torch form proven in
+# gates/7-pixal3d/aux-models/naf_ref.py (max |diff| vs NATTEN <= 4.6e-7).
+NATTEN_RECENT = True
+
+
+def na2d_block(q, k_lr, v_lr, kernel_size, scale=None, block_chunk=1024):
+    """K/V are the low-res maps; every hi-res query in low-res block (bi, bj)
+    attends to the same kh x kw low-res window starting at
+    clamp(bi - kh//2, 0, hk - kh). q [B,H,W,N,D] -> [B,H,W,N,Dv]."""
+    B, H, W, N, D = q.shape
+    _, hk, wk, _, Dv = v_lr.shape
+    dh, dw = H // hk, W // wk
+    assert dh * hk == H and dw * wk == W, "na2d_block needs an integer upsample factor"
+    kh, kw = kernel_size
+    scale = D ** -0.5 if scale is None else scale
+    dev = q.device
+    sh = (torch.arange(hk, device=dev) - kh // 2).clamp(0, hk - kh)
+    sw = (torch.arange(wk, device=dev) - kw // 2).clamp(0, wk - kw)
+    wh = sh[:, None] + torch.arange(kh, device=dev)
+    ww = sw[:, None] + torch.arange(kw, device=dev)
+    idx = (wh[:, None, :, None] * wk + ww[None, :, None, :]).reshape(hk * wk, kh * kw)
+    qb = q.reshape(B, hk, dh, wk, dw, N, D).permute(0, 1, 3, 5, 2, 4, 6).reshape(B, hk * wk, N, dh * dw, D)
+    kf = k_lr.reshape(B, hk * wk, N, D)
+    vf = v_lr.reshape(B, hk * wk, N, Dv)
+    out = torch.empty(B, hk * wk, N, dh * dw, Dv, dtype=q.dtype, device=dev)
+    for s in range(0, hk * wk, block_chunk):
+        ii = idx[s:s + block_chunk]
+        kg = kf[:, ii].permute(0, 1, 3, 2, 4)
+        vg = vf[:, ii].permute(0, 1, 3, 2, 4)
+        a = (qb[:, s:s + block_chunk] @ kg.transpose(-1, -2) * scale).softmax(-1)
+        out[:, s:s + block_chunk] = a @ vg
+    return out.reshape(B, hk, wk, N, dh, dw, Dv).permute(0, 1, 4, 2, 5, 3, 6).reshape(B, H, W, N, Dv)
 
