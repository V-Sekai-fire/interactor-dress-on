+def _as_usd(path: Path, work: Path, stem: str) -> Path:
+    """The bytes must be an OpenUSD layer (crate or text); GLB is refused."""
+    head = path.read_bytes()[:8]
+    if head == b"PXR-USDC":
+        out = work / f"{stem}.usdc"
+    elif head.startswith(b"#usda"):
+        out = work / f"{stem}.usda"
+    else:
+        raise InputError(f"{stem} must be an OpenUSD layer (usda text or usdc crate), got {head!r}")
+    path.replace(out)
+    return out
+
