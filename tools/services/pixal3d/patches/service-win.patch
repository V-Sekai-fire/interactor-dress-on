+def _add_meshes(stage, glb: Path) -> int:
+    """interactor-dress-on (service-win.patch): OpenUSD is the interchange, so the
+    layer carries the geometry itself -- one UsdGeom.Mesh per glTF primitive, in
+    the GLB's own frame (Y up, meters: extract() already rotated it), with vertex
+    normals and the UV set as primvars:st. Returns the number of meshes."""
+    import numpy as np
+    import trimesh
+    from pxr import Gf, Sdf, UsdGeom, Vt
+
+    try:
+        scene = trimesh.load(str(glb), force="scene")
+    except Exception:
+        return 0
+    count = 0
+    for node in scene.graph.nodes_geometry:
+        transform, geom_name = scene.graph[node]
+        mesh = scene.geometry[geom_name]
+        if not isinstance(mesh, trimesh.Trimesh) or len(mesh.faces) == 0:
+            continue
+        mesh = mesh.copy()
+        mesh.apply_transform(transform)
+        prim = UsdGeom.Mesh.Define(stage, f"/Asset/Geometry/Mesh_{count}")
+        points = np.asarray(mesh.vertices, dtype=np.float32)
+        prim.CreatePointsAttr(Vt.Vec3fArray.FromNumpy(points))
+        faces = np.asarray(mesh.faces, dtype=np.int32)
+        prim.CreateFaceVertexCountsAttr(Vt.IntArray.FromNumpy(np.full(len(faces), 3, np.int32)))
+        prim.CreateFaceVertexIndicesAttr(Vt.IntArray.FromNumpy(faces.reshape(-1)))
+        prim.CreateNormalsAttr(Vt.Vec3fArray.FromNumpy(np.asarray(mesh.vertex_normals, np.float32)))
+        prim.SetNormalsInterpolation(UsdGeom.Tokens.vertex)
+        # glTF winds counter-clockwise, as USD's default rightHanded does
+        prim.CreateOrientationAttr(UsdGeom.Tokens.rightHanded)
+        prim.CreateSubdivisionSchemeAttr(UsdGeom.Tokens.none)
+        prim.CreateExtentAttr(Vt.Vec3fArray([Gf.Vec3f(*points.min(0).tolist()), Gf.Vec3f(*points.max(0).tolist())]))
+        uv = getattr(mesh.visual, "uv", None)
+        if uv is not None and len(uv) == len(points):
+            st = UsdGeom.PrimvarsAPI(prim).CreatePrimvar(
+                "st", Sdf.ValueTypeNames.TexCoord2fArray, UsdGeom.Tokens.vertex)
+            st.Set(Vt.Vec2fArray.FromNumpy(np.asarray(uv, np.float32)))
+        count += 1
+    return count
+
