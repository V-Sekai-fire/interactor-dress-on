+    textures. The GLB is not in the package: plain usd-core reads no glTF, so
+    the layer names only its format. Returns (the package, {file in the
+    package: bytes})."""
+    import trimesh
     from pxr import Sdf, Usd, UsdGeom
 
-    layer = work / "layer.usda"
+    pkg = work / "usdz"
+    pkg.mkdir(exist_ok=True)
+    layer = pkg / USDZ_LAYER
     stage = Usd.Stage.CreateNew(str(layer))
     UsdGeom.SetStageUpAxis(stage, UsdGeom.Tokens.y)
     UsdGeom.SetStageMetersPerUnit(stage, 1.0)
     root = UsdGeom.Xform.Define(stage, "/Asset")
     stage.SetDefaultPrim(root.GetPrim())
-    geometry = stage.DefinePrim("/Asset/Geometry")
-    geometry.CreateAttribute("weftspun:sourceAsset", Sdf.ValueTypeNames.Asset).Set(
-        Sdf.AssetPath(glb.name)
-    )
+    geometry = UsdGeom.Xform.Define(stage, "/Asset/Geometry").GetPrim()
     geometry.CreateAttribute("weftspun:sourceFormat", Sdf.ValueTypeNames.Token).Set("gltf")
     geometry.CreateAttribute("weftspun:stage", Sdf.ValueTypeNames.Token).Set("image_to_mesh")
+    files = {}
+    # a GLB that does not load is an error, not an empty asset
+    _add_meshes(stage, trimesh.load(str(glb), force="scene"), files)
     stage.GetRootLayer().Save()
-    return layer
+    for rel, data in files.items():
+        (pkg / rel).parent.mkdir(parents=True, exist_ok=True)
+        (pkg / rel).write_bytes(data)
+    usdz = work / "asset.usdz"
+    writer = Sdf.ZipFileWriter.CreateNew(str(usdz))
+    writer.AddFile(str(layer), USDZ_LAYER)  # the first file is the root layer
+    for rel in files:
+        writer.AddFile(str(pkg / rel), rel)
+    writer.Save()
+    return usdz, {USDZ_LAYER: layer.stat().st_size, **{rel: len(data) for rel, data in files.items()}}
+
