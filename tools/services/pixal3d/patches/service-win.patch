+# interactor-dress-on (service-win.patch): /extract answers with ONE .usdz. Its
+# first file, the package's root layer, is asset.usdc (USD's binary crate: 6.9 MB
+# for a 195k-point mesh whose .usda text was 25.2 MB); the textures of the GLB's
+# materials follow as PNG files under textures/. A usdz stores every file
+# uncompressed at a 64-byte aligned offset; Sdf.ZipFileWriter writes it so.
+USDZ_LAYER = "asset.usdc"
