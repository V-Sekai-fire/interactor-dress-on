+def _mark_region(state: dict) -> None:
+    """The mesh and the region Cube are put in VoxHammer's unit frame (y-up,
+    largest extent 1, bbox centred) with the SAME scale/offset, so the mask
+    means what the caller drew; the inverse maps the result back."""
+    import numpy as np
+    usd_io = _RT["usd_io"]
+    work = state["work"]
+    v, f, _rgb, up = usd_io.read_mesh(state["mesh_path"])
+    if up == "Z":
+        v = usd_io.zup_to_yup(v)
+    lo, hi, rup = usd_io.read_cube(state["region_path"])
+    if rup == "Z":
+        c = usd_io.zup_to_yup(np.array([lo, hi]))
+        lo, hi = c.min(0), c.max(0)
+    scale = 1.0 / float((v.max(0) - v.min(0)).max())
+    vs = v * scale
+    offset = -(vs.min(0) + vs.max(0)) / 2
+    state.update(up=up, scale=scale, offset=offset)
+    state["unit_mesh"] = work / "unit_mesh.usda"
+    state["unit_region"] = work / "unit_region.usda"
+    usd_io.write_mesh(state["unit_mesh"], vs + offset, f, None, up="Y", frame="unit-cube-yup")
+    usd_io.write_cube(state["unit_region"], lo * scale + offset, hi * scale + offset, up="Y",
+                      frame="unit-cube-yup")
+    state["render_dir"] = work / "render"
+    state["render_dir"].mkdir()
+
+
+def _voxelize(state: dict) -> None:
