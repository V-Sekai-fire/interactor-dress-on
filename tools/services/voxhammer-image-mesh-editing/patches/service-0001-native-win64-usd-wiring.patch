+    src = Usd.Stage.Open(str(state["mesh_path"]))
+    mpu = UsdGeom.GetStageMetersPerUnit(src)
+    edited = state["work"] / "edited.usdc"
+    usd_io.write_mesh(edited, v, f, rgb, up=state["up"], meters_per_unit=mpu, frame="source",
+                      source=f"voxhammer:TRELLIS-image-large:seed{state['seed']}")
+    state["edited"] = edited
+    state["faces"] = int(len(f))
+    state["vertices"] = int(len(v))
+
