diff --git a/vendor/pmp-subset/pmp/algorithms/remeshing.cpp b/vendor/pmp-subset/pmp/algorithms/remeshing.cpp
index 4145f63..5d589fb 100644
--- a/vendor/pmp-subset/pmp/algorithms/remeshing.cpp
+++ b/vendor/pmp-subset/pmp/algorithms/remeshing.cpp
@@ -10,7 +10,15 @@
 #include <memory>
 #include <limits>
 
+// interactor-dress-on: PMP_NO_EIGEN compiles out adaptive remeshing's
+// curvature sizing (curvature.cpp needs Eigen and is not vendored). Uniform
+// remeshing, the path Cassie's refine/cassie_remesh use, is unchanged.
+#ifndef PMP_NO_EIGEN
 #include "pmp/algorithms/curvature.h"
+#else
+#include <cstdio>
+#include <cstdlib>
+#endif
 #include "pmp/algorithms/normals.h"
 #include "pmp/algorithms/barycentric_coordinates.h"
 #include "pmp/algorithms/differential_geometry.h"
@@ -450,6 +458,13 @@ void Remeshing::preprocessing()
     }
     else
     {
+#ifdef PMP_NO_EIGEN
+        // Adaptive sizing needs curvature(), compiled out under
+        // PMP_NO_EIGEN. Fail loudly rather than remesh with a wrong field.
+        std::fprintf(stderr,
+                     "pmp: adaptive_remeshing needs curvature (PMP_NO_EIGEN)\n");
+        std::abort();
+#else
         // compute curvature for all mesh vertices, using cotan or Cohen-Steiner
         // don't use two-ring neighborhood, since we otherwise compute
         // curvature over sharp features edges, leading to high curvatures.
@@ -550,6 +565,7 @@ void Remeshing::preprocessing()
             // store target edge length
             vsizing_[v] = h;
         }
+#endif // PMP_NO_EIGEN
     }
 
     if (use_projection_)
