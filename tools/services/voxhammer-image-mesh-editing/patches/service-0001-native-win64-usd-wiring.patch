+    state["times"]["render_s"] = round(time.time() - t, 2)
+    import torch
+    inference = _RT["drv"].inference
+    t = time.time()
+    # extract_features runs DINOv2 with autograd on and keeps every batch's tokens:
+    # measured, the 4090 filled to 24.1 GB by batch 3 of 15 and WDDM paged it out
+    # (24 s -> 76 s a batch) until it failed. Its bare `except:` then reports success,
+    # so the file it should have written is the check.
+    features = state["render_dir"] / "features.npz"
