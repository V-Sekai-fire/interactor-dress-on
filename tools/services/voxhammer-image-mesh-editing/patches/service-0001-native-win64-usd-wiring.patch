+def _write_layer(state: dict) -> None:
+    """The decoded mesh, back in the caller's frame, as a crate with real geometry."""
+    usd_io = _RT["usd_io"]
+    vy, f, rgb = _RT["drv"]._EXPORT_STATE["last_mesh"]
