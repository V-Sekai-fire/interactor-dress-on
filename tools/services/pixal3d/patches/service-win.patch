+def _texture_png(image, keep_alpha: bool) -> bytes:
+    """One glTF texture as PNG bytes, the GLB's own pixels. The alpha channel of
+    an OPAQUE material is dropped: glTF ignores it ("any alpha value is
+    ignored"), and it was 18% of the base color PNG (9.03 -> 7.40 MB at 2048)."""
+    import io
+
+    import numpy as np
+    from PIL import Image
+
+    img = image if isinstance(image, Image.Image) else Image.fromarray(np.asarray(image))
+    if img.mode not in ("L", "LA", "RGB", "RGBA"):
+        img = img.convert("RGBA" if "A" in img.getbands() else "RGB")
+    if not keep_alpha and img.mode in ("LA", "RGBA"):
+        img = img.convert(img.mode[:-1])
+    buf = io.BytesIO()
+    img.save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def _add_material(stage, index: int, material, files: dict):
+    """glTF metallic-roughness -> a UsdPreviewSurface Material under
+    /Asset/Materials. Each texture the GLB carries (base color, sRGB; the
+    metallicRoughness map, raw, roughness in G and metallic in B as glTF packs
+    them; normal, occlusion, emissive when present -- o_voxel writes the first
+    two) is a UsdUVTexture reading primvars:st, its glTF factor as the texture's
+    scale; without a texture the factor is the constant. The PNGs go into
+    `files` (path inside the package -> bytes)."""
+    import numpy as np
+    import trimesh
+    from pxr import Gf, Sdf, UsdShade
+
+    if not isinstance(material, trimesh.visual.material.PBRMaterial):
+        if not hasattr(material, "to_pbr"):
+            return None
+        material = material.to_pbr()
+
+    def floats(value, default):
+        if value is None:
+            return list(default)
+        v = np.asarray(value).reshape(-1)
+        if v.dtype == np.uint8:  # trimesh keeps colour factors as uint8
+            v = v / 255.0
+        return [float(x) for x in v[: len(default)]] + list(default[len(v):])
+
+    base_factor = floats(material.baseColorFactor, (1.0, 1.0, 1.0, 1.0))
+    metallic = 1.0 if material.metallicFactor is None else float(material.metallicFactor)
+    roughness = 1.0 if material.roughnessFactor is None else float(material.roughnessFactor)
+    emissive = floats(material.emissiveFactor, (0.0, 0.0, 0.0))
+    alpha_mode = str(material.alphaMode or "OPAQUE").upper()
+    T = Sdf.ValueTypeNames
+
+    path = f"/Asset/Materials/Material_{index}"
+    mat = UsdShade.Material.Define(stage, path)
+    surface = UsdShade.Shader.Define(stage, f"{path}/PreviewSurface")
+    surface.CreateIdAttr("UsdPreviewSurface")
+    mat.CreateSurfaceOutput().ConnectToSource(surface.ConnectableAPI(), "surface")
+    reader = UsdShade.Shader.Define(stage, f"{path}/StReader")
+    reader.CreateIdAttr("UsdPrimvarReader_float2")
+    reader.CreateInput("varname", T.String).Set("st")
+    reader.CreateOutput("result", T.Float2)
+
+    def texture(name, image, color_space, keep_alpha, scale, bias=None):
+        rel = f"textures/material{index}_{name}.png"
+        files[rel] = _texture_png(image, keep_alpha)
+        tex = UsdShade.Shader.Define(stage, f"{path}/{name}")
+        tex.CreateIdAttr("UsdUVTexture")
+        tex.CreateInput("file", T.Asset).Set(Sdf.AssetPath(rel))
+        tex.CreateInput("st", T.Float2).ConnectToSource(reader.ConnectableAPI(), "result")
+        tex.CreateInput("sourceColorSpace", T.Token).Set(color_space)
+        tex.CreateInput("wrapS", T.Token).Set("repeat")  # glTF's default sampler
+        tex.CreateInput("wrapT", T.Token).Set("repeat")
+        tex.CreateInput("scale", T.Float4).Set(Gf.Vec4f(*scale))
+        if bias is not None:
+            tex.CreateInput("bias", T.Float4).Set(Gf.Vec4f(*bias))
+        return tex
+
+    def connect(input_name, input_type, tex, channel, channel_type):
+        tex.CreateOutput(channel, channel_type)
+        surface.CreateInput(input_name, input_type).ConnectToSource(tex.ConnectableAPI(), channel)
+
+    blended = alpha_mode != "OPAQUE"
+    if material.baseColorTexture is not None:
+        bc = texture("base_color", material.baseColorTexture, "sRGB", blended, base_factor)
+        connect("diffuseColor", T.Color3f, bc, "rgb", T.Float3)
+        if blended:
+            connect("opacity", T.Float, bc, "a", T.Float)
+    else:
+        surface.CreateInput("diffuseColor", T.Color3f).Set(Gf.Vec3f(*base_factor[:3]))
+        if blended:
+            surface.CreateInput("opacity", T.Float).Set(base_factor[3])
+    if alpha_mode == "MASK":
+        cutoff = getattr(material, "alphaCutoff", None)
+        surface.CreateInput("opacityThreshold", T.Float).Set(0.5 if cutoff is None else float(cutoff))
+    if material.metallicRoughnessTexture is not None:
+        mr = texture("metallic_roughness", material.metallicRoughnessTexture, "raw", False,
+                     (1.0, roughness, metallic, 1.0))
+        connect("roughness", T.Float, mr, "g", T.Float)
+        connect("metallic", T.Float, mr, "b", T.Float)
+    else:
+        surface.CreateInput("roughness", T.Float).Set(roughness)
+        surface.CreateInput("metallic", T.Float).Set(metallic)
+    if material.normalTexture is not None:  # tangent space, +Y up in both
+        nt = texture("normal", material.normalTexture, "raw", False, (2.0, 2.0, 2.0, 1.0), (-1.0, -1.0, -1.0, 0.0))
+        connect("normal", T.Normal3f, nt, "rgb", T.Float3)
+    if material.occlusionTexture is not None:
+        oc = texture("occlusion", material.occlusionTexture, "raw", False, (1.0, 1.0, 1.0, 1.0))
+        connect("occlusion", T.Float, oc, "r", T.Float)
+    if material.emissiveTexture is not None:
+        em = texture("emissive", material.emissiveTexture, "sRGB", False, (*emissive, 1.0))
+        connect("emissiveColor", T.Color3f, em, "rgb", T.Float3)
+    elif any(emissive):
+        surface.CreateInput("emissiveColor", T.Color3f).Set(Gf.Vec3f(*emissive))
+    return mat
+
