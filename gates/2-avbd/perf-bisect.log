# Stage 2 rd performance bisect, 2026-09-22/23, Godot 4.7.2, RTX 4090
#
# Every ELF below was loaded into its own Sandbox in ONE Godot process
# (scratch runner perf_ab.gd, references_max 4096, JIT on) and timed on the
# host around the vmcall. 'probe' = dress_on rd_bench_quiet(accumulate.spv,
# 64 dispatches + barriers, 1 submit+sync), 3 calls, host us each. 'bench' =
# drape avbd_bench <backend> NxN, 5 substeps x 10 iterations, one-shot
# (the pre-rule-4 entry point, still present in these builds), ms/substep.
# 'calls <kind>' = rd_calls: 1000 calls of ONE kind in a loop (32 for
# submit = begin/end/submit/sync).
#
# ELFs (scratchpad/perf/):
#   head            git show HEAD:project/dress_on.elf (fdf18e1), probe + bench
#   now_*           the working tree before the fix (method names as literals)
#   prefix_*        = now, rebuilt from the frozen snapshot (variant.py prefix)
#   noperm_*        prefix, RIDs NOT made permanent, no ECALL_VSTORE_GLOBAL (candidate a)
#   noframe_*       prefix, no Engine.get_process_frames at submit/sync (candidate b)
#   forced_*        the fix, but compute_list_dispatch deliberately placed in
#                   compute_list_bind_compute_pipeline's host name-cache slot
#   fixed_*         the fix: every RenderingDevice method name copied to a
#                   static pool at an address with a host name-cache slot of its own
# Candidates (c) padding, (d) buffer_clear/saxpby, (e) CMake add_stage_elf vs
# add_sandbox_program and (f) references_max are identical across prefix,
# noperm, noframe, forced and fixed (same sources, same CMakeLists, same
# runner), so the 60-100x between prefix and fixed is not theirs.

## variant.py (the build variants)
# Build-variant patcher for the perf bisect. Operates on a scratch source tree.
# usage: variant.py <srcdir> <variant>
#   prefix     : rd_compute as it was before the fix (literals at link-time addresses)
#   noperm     : prefix + no make_permanent/vstore_global (candidate a)
#   noframe    : prefix + no Engine.get_process_frames at submit/sync (candidate b)
#   fixed      : the fix as in the repo (no change)
#   forced     : fix, but compute_list_dispatch forced into compute_list_bind_compute_pipeline's slot
import re, sys, os
src, var = sys.argv[1], sys.argv[2]
rc = os.path.join(src, "guest", "rd_compute.cpp")
s = open(rc).read()

def to_prefix(s):
    names = re.search(r'const char \*const kNameText\[N_COUNT\] = \{(.*?)\};', s, re.S).group(1)
    texts = re.findall(r'"([^"]+)"', names)
    enums = re.search(r'enum Name : int \{(.*?)N_COUNT', s, re.S).group(1)
    ids = [e.strip().rstrip(',') for e in enums.split('\n') if e.strip()]
    for i, t in zip(ids, texts):
        s = s.replace('nm(%s)' % i, '"%s"' % t)
    a = s.index('// --- method names at addresses')
    b = s.index('// RID::RID(const Variant&)')
    s = s[:a] + 'std::string name_slots() { return "literals (pre-fix)"; }\n\n' + s[b:]
    return s

if var in ("prefix", "noperm", "noframe"):
    s = to_prefix(s)
if var == "noperm":
    s = s.replace('\tVariant p = v;\n\tp.make_permanent();\n\t::RID r = as_rid(p);', '\t::RID r = as_rid(v);')
    s = s.replace('\tVariant held(rid);\n\tVariant nil;\n\tsys_vstore_global(&held, &nil);', '\t(void)rid;')
if var == "noframe":
    s = s.replace('\tsubmit_frame_ = process_frame();\n', '')
    s = s.replace('\tif (process_frame() == submit_frame_) {\n\t\t++same_frame_syncs_;\n\t}\n', '')
if var == "forced":
    old = '''				const unsigned s = host_slot(reinterpret_cast<uintptr_t>(pool + off));
				if (!used[s]) {'''
    new = '''				const unsigned s = host_slot(reinterpret_cast<uintptr_t>(pool + off));
				const bool want = i == N_DISPATCH ? s == host_slot(reinterpret_cast<uintptr_t>(at[N_BIND_PIPELINE])) : !used[s];
				if (want) {'''
    assert old in s
    s = s.replace(old, new)
open(rc, "w").write(s)
print("variant", var, "applied")

## Host name-cache slots of the method-name literals, slot = ((addr * 2654435761) >> 8) & 31
## (slots.py over .rodata; for fixed/forced the literals listed are unused, the pool is in .bss)
== head.elf
  collisions: slot 5: set_binding, limit_get; slot 7: compute_list_dispatch, compute_pipeline_create; slot 18: compute_list_bind_uniform_set, storage_buffer_create; slot 28: free_rid, add_id
== now_dress_on.elf
  collisions: slot 9: buffer_get_data, limit_get; slot 10: compute_list_bind_compute_pipeline, compute_list_dispatch; slot 17: uniform_buffer_create, set_stage_bytecode; slot 19: get_process_frames, set_uniform_type; slot 20: compute_list_begin, compute_list_add_barrier, buffer_update; slot 23: sync, add_id; slot 28: submit, uniform_set_create, compute_pipeline_create
== now_drape.elf
  collisions: slot 2: submit, uniform_buffer_create; slot 8: buffer_get_data, limit_get; slot 11: compute_list_dispatch, uniform_set_is_valid; slot 13: shader_create_from_spirv, set_uniform_type; slot 15: compute_list_bind_compute_pipeline, compute_list_add_barrier, buffer_clear; slot 31: uniform_set_create, set_binding
== prefix_dress_on.elf
  collisions: slot 9: buffer_get_data, limit_get; slot 10: compute_list_bind_compute_pipeline, compute_list_dispatch; slot 16: buffer_clear, free_rid; slot 17: uniform_buffer_create, set_stage_bytecode; slot 19: get_process_frames, set_uniform_type; slot 20: compute_list_begin, compute_list_add_barrier, buffer_update; slot 23: compute_list_end, sync, add_id; slot 28: submit, uniform_set_create, compute_pipeline_create
== prefix_drape.elf
  collisions: slot 2: submit, uniform_buffer_create; slot 8: buffer_get_data, limit_get; slot 11: compute_list_dispatch, uniform_set_is_valid; slot 13: shader_create_from_spirv, set_uniform_type; slot 15: compute_list_bind_compute_pipeline, compute_list_add_barrier, buffer_clear; slot 17: free_rid, set_stage_bytecode; slot 27: get_process_frames, add_id; slot 31: uniform_set_create, set_binding

